# Telegram: https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=tradelife

# DeepSeek: https://platform.deepseek.com
# Chart/vision calls use the multimodal V4.1-Flash model (canonical id: deepseek-flash).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_VISION_MODEL=deepseek-flash

# Hyperliquid API wallet: https://app.hyperliquid.xyz/API
HL_ACCOUNT_ADDRESS=
HL_SECRET_KEY=
# main | testnet
HL_NETWORK=testnet

# Solana: prefer GMGN official CLI for second-level market buys.
# Apply key at https://gmgn.ai/ai  then: npm install -g gmgn-cli && gmgn-cli config --apply <KEY>
GMGN_API_KEY=
GMGN_WALLET=
# Headless live swaps also need this AND --live AND LIVE_TRADING=1
GMGN_ALLOW_AUTOMATED_TRADES=0
# Fallback if gmgn-cli is missing: Jupiter + base58 key
SOLANA_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Must be 1 AND pass --live to send real orders.
LIVE_TRADING=0
